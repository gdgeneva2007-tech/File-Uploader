<%- include("../partials/header") %>
<p>Name:<%= file.name %></p>

<!-- 
Check if file is an image by its mimetype
If image: display it directly
If other: show download link only
 -->

 <% const isImage=file.mimetype && file.mimetype.startsWith("image/") %>
 <% if(isImage){ %>
  <img src="<%= file.url %>" alt="<%= file.name %>"
  style="max-width: 500px;">
<% }else{ %>
  <p>🗋 This is a <%= file.mimetype %> file</p>
<% } %>

<p>url:<%= file.url %></p>
<p>Uploaded at:<%= file.uploadedAt %></p>

<!-- 
For download: add fl_attachment to URL
This force browser to download instead of display
 -->
<% 
  const downloadUrl=file.url.replace("/upload/","/upload/fl_attachment/")
%>
<a href="<%= downloadUrl %>" download="file.name">Download</a>

<form action="/files/<%= file.id %>/delete" method="POST" class="space-y-4 bg-white p-6 rounded-xl shadow-sm border border-gray-200">
    <button type="submit" onclick="return confirm('Delete this file permanently?')" class="p-4 w-full bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 font-medium">
      Delete
    </button>
</form>

<%- include("../partials/footer") %>